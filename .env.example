# 서울 열린데이터광장 인증키
# 발급: https://data.seoul.go.kr → 마이페이지 → 인증키 신청
SEOUL_OPEN_DATA_API_KEY=your_seoul_api_key_here

# Google Gemini API 키 (gemini-2.5-flash, 무료 티어)
# 발급: https://aistudio.google.com → Get API key
GEMINI_API_KEY=your_gemini_api_key_here

# Google OAuth 2.0 자격증명 (데스크톱 앱 유형)
# 발급: https://console.cloud.google.com → API 및 서비스 → 사용자 인증 정보
# → OAuth 클라이언트 ID 만들기 → 데스크톱 앱
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret_here

# Google OAuth refresh_token
# 발급: https://developers.google.com/oauthplayground
# → 오른쪽 위 톱니바퀴 → Use your own OAuth credentials 체크
# → Step 1: scope 입력: https://www.googleapis.com/auth/blogger
# → Step 2: 코드 교환 → Step 3: refresh_token 복사
GOOGLE_REFRESH_TOKEN=your_refresh_token_here

# Blogger 블로그 ID
# 확인: https://blogger.com → 블로그 선택 → 설정 → 블로그 ID
# 또는 블로그 URL: https://www.blogger.com/blog/posts/[BLOG_ID]
BLOGGER_BLOG_ID=your_blog_id_here

# 카카오 REST API 키 (주차장 검색)
# 발급: https://developers.kakao.com → 내 애플리케이션 → REST API 키
KAKAO_REST_API_KEY=your_kakao_rest_api_key_here

# 초안 여부: true=초안저장(기본값), false=즉시공개
# 며칠간 결과물 확인 후 false로 변경하세요
BLOGGER_IS_DRAFT=true
